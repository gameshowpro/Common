@implements IAsyncDisposable
@inject IJSRuntime _js

@* A collapsible subsection: a heading whose button (chevron, aria-expanded) opens and closes the body, and a short factual
   summary shown while it is closed. The open state is remembered per viewer in localStorage under StorageKey (through
   gsp-storage.js, imported on first use); without a key, or when storage or the import is missing, blocked or throws,
   DefaultOpen applies. The body is rendered only while open. *@
<div class="gsp-collapsible @(_open ? "open" : "closed")" data-gsp-section="@StorageKey">
    <div class="gsp-collapsible-header">
        <MudText Typo="Typo.subtitle1" HtmlTag="@HeadingTag" Class="gsp-collapsible-heading">
            <button type="button" class="gsp-collapsible-toggle" aria-expanded="@(_open ? "true" : "false")"
                    aria-controls="@(_open ? _bodyId : null)" @onclick="Toggle">
                <MudIcon Icon="@(_open ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small" />
                @if (Icon is not null)
                {
                    <MudIcon Icon="@Icon" Size="Size.Small" aria-hidden="true" />
                }
                <span class="gsp-collapsible-title">@Title</span>
            </button>
        </MudText>
        @if (!_open)
        {
            if (SummaryContent is not null)
            {
                @SummaryContent
            }
            else if (!string.IsNullOrEmpty(Summary))
            {
                <span class="gsp-collapsible-summary">@Summary</span>
            }
        }
    </div>
    @if (_open)
    {
        <div id="@_bodyId" class="gsp-collapsible-body">
            @ChildContent
        </div>
    }
</div>

@code {
    private static int s_nextId;
    private readonly string _bodyId = $"gsp-collapsible-{Interlocked.Increment(ref s_nextId)}";
    private bool _open;
    private bool _loaded;
    private IJSObjectReference? _module;

    /// <summary>The heading text.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>An optional icon (an SVG path, as for <c>MudIcon</c>) shown before the title.</summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>The element that wraps the toggle button (default <c>h3</c>).</summary>
    [Parameter]
    public string HeadingTag { get; set; } = "h3";

    /// <summary>One short factual line shown beside the title while the section is closed.</summary>
    [Parameter]
    public string? Summary { get; set; }

    /// <summary>
    /// Replaces the plain <see cref="Summary"/> span while the section is closed (for example to wrap the summary in a tooltip).
    /// Give it an element with class <c>gsp-collapsible-summary</c> to keep the summary styling.
    /// </summary>
    [Parameter]
    public RenderFragment? SummaryContent { get; set; }

    /// <summary>The full localStorage key the open state is kept under (unique per section); without one the state is not remembered.</summary>
    [Parameter]
    public string? StorageKey { get; set; }

    /// <summary>Whether the section starts open when the viewer has not chosen yet.</summary>
    [Parameter]
    public bool DefaultOpen { get; set; }

    /// <summary>The body, rendered only while the section is open.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _open = DefaultOpen;
        string? key = StorageKey;
        if (!string.IsNullOrEmpty(key))
        {
            try
            {
                _module ??= await _js.InvokeAsync<IJSObjectReference>("import", "./_content/GameshowPro.Common.Blazor/gsp-storage.js");
                string? stored = await _module.InvokeAsync<string?>("get", key);
                if (stored is "open" or "closed")
                {
                    _open = stored == "open";
                }
            }
            catch (Exception)
            {
                // Storage, the module or interop unavailable: keep the default.
            }
        }

        _loaded = true;
    }

    private async Task Toggle()
    {
        _open = !_open;
        string? key = StorageKey;
        if (!_loaded || string.IsNullOrEmpty(key))
        {
            return;
        }

        try
        {
            _module ??= await _js.InvokeAsync<IJSObjectReference>("import", "./_content/GameshowPro.Common.Blazor/gsp-storage.js");
            await _module.InvokeVoidAsync("set", key, _open ? "open" : "closed");
        }
        catch (Exception)
        {
            // Not remembered; the toggle itself already worked.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (Exception)
            {
                // The circuit or page has gone; nothing to release.
            }
        }
    }
}
