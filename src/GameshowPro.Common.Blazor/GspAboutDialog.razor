    private ElementReference _dialog;
    private GspAppInfo? _info;
    private GspRuntimeState? _state;
    private GspLocalTimeFormatter? _localTime;
    private string _buildText = "Build time unavailable";
    private bool _buildTimeRequested;
    private IJSObjectReference? _module;

    /// <summary>Product-specific extras shown after the links and the legal line.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string Legal => string.Join(' ', new[] { _info?.Trademark, _info?.Copyright }.Where(t => !string.IsNullOrEmpty(t))).TrimEnd('.') + ".";

    private IEnumerable<GspAboutRow> Rows()
    {
        if (!string.IsNullOrEmpty(_info?.FullVersion))
        {
            yield return new GspAboutRow("Version", _info.FullVersion);
        }
        if (_info is not null)
        {
            yield return new GspAboutRow("Build", _buildText);
        }
        if (!string.IsNullOrEmpty(_state?.HostName))
        {
            yield return new GspAboutRow("Host", _state.HostName);
        }
        if (!string.IsNullOrEmpty(_state?.Platform))
        {
            yield return new GspAboutRow("Platform", _state.Platform);
        }
        foreach (GspAboutRow row in _state?.AboutRows ?? [])
        {
            yield return row;
        }
    }

    protected override void OnInitialized()
    {
        _info = _services.GetService<GspAppInfo>();
        _state = _services.GetService<GspRuntimeState>();
        _localTime = _services.GetService<GspLocalTimeFormatter>();
        if (_state is not null)
        {
            _state.AboutRequested += OnAboutRequested;
            _state.Changed += OnStateChanged;
            _state.SetAboutAvailable(true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // One attempt per instance: when the browser time zone is unavailable, retrying would repeat a failing interop call on every render.
        if (_buildTimeRequested || _localTime is null || _info?.BuildInstantUtc is not { } instant)
        {
            return;
        }
        _buildTimeRequested = true;
        try
        {
            if (await _localTime.FormatAsync(instant) is { } formatted)
            {
                _buildText = formatted;
                StateHasChanged();
            }
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            // JavaScript may be unavailable during a disconnected or test render.
        }
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnAboutRequested() => _ = InvokeAsync(ShowAsync);

    /// <summary>Opens the dialog.</summary>
    public async Task ShowAsync()
    {
        try
        {
            _module ??= await _js.InvokeAsync<IJSObjectReference>("import", "./_content/GameshowPro.Common.Blazor/gsp-dialog.js");
            await _module.InvokeVoidAsync("showModal", _dialog);
        }
        catch (JSDisconnectedException)
        {
            // The circuit has gone, so there is no page left to show the dialog on.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_state is not null)
        {
            _state.AboutRequested -= OnAboutRequested;
            _state.Changed -= OnStateChanged;
            _state.SetAboutAvailable(false);
        }
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
