@implements IAsyncDisposable
@inject IServiceProvider _services
@inject IJSRuntime _js

@* The About dialog: a native <dialog> (Escape, the dimmed backdrop, focus return to the opener and the page behind going
   inert come from the browser); gsp-dialog.js only opens it and closes it on a backdrop click. It reads the app's identity
   (GspAppInfo) and the runtime facts (GspRuntimeState) by injection, and opens when GspRuntimeState.RequestAbout is called
   (the header's version pill, the footer's About link and GspAboutButton all do). *@
<dialog @ref="_dialog" class="gsp-dialog gsp-about" aria-labelledby="gsp-about-heading">
    <div class="gsp-dialog-body">
        <div class="gsp-about-brand">
            @if (!string.IsNullOrEmpty(_info?.IconUrl))
            {
                <img class="gsp-about-logo" src="@_info!.IconUrl" alt="" />
            }
            <div>
                <h2 id="gsp-about-heading">@_info?.ProductName</h2>
                @if (!string.IsNullOrEmpty(_info?.Tagline))
                {
                    <p class="gsp-hint">@_info!.Tagline</p>
                }
            </div>
        </div>
        @if (Rows().Any())
        {
            <table class="gsp-kv">
                <tbody>
                    @foreach (GspAboutRow row in Rows())
                    {
                        <tr><th>@row.Label</th><td class="gsp-data">@row.Value</td></tr>
                    }
                </tbody>
            </table>
        }
        @if (!string.IsNullOrEmpty(_info?.LicenseText))
        {
            <h3>License</h3>
            <p>@_info!.LicenseText</p>
        }
        @if (_info is { Links.Count: > 0 })
        {
            <p class="gsp-about-links">
                @foreach (GspAboutLink link in _info.Links)
                {
                    <a href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Text</a>
                }
            </p>
        }
        <p class="gsp-hint">@Legal</p>
        @ChildContent
        <div class="gsp-about-credit">
            <a href="https://github.com/gameshowpro" target="_blank" rel="noopener noreferrer">
                @((MarkupString)LogoSvg)
                <span>A GameshowPro application</span>
            </a>
        </div>
    </div>
    <form method="dialog" class="gsp-dialog-foot">
        <button type="submit" class="gsp-button" autofocus>Close</button>
    </form>
</dialog>

@code {
    private const string LogoSvg = """<svg class="gsp-logo" role="img" aria-label="GameshowPro" viewBox="0 0 128 128" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" xml:space="preserve" style="fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2;"><path d="M88.19,91.416c0.161,11.778 -8.475,24.39 -8.475,24.39l-22.034,0l2.497,-4.995l-50,0c0,-55.192 44.808,-100 100,-100l0,8.339c-19.693,8.618 -33.776,29.329 -44.49,47.786c-12.512,21.554 22.448,20.583 22.502,24.48Z" style="fill:#8d0000;"/><path d="M110.178,24.223c-18.926,10.967 -33.934,27.96 -42.388,48.347c-0.751,1.838 -0.538,3.93 0.569,5.579c1.107,1.649 2.963,2.638 4.949,2.638c2.218,0.019 4.721,0.019 7.327,0.019c5.258,0 10.141,2.722 12.907,7.194c2.765,4.472 3.018,10.057 0.669,14.761l-9.041,18.1l-10.009,0l10.695,-21.389c0.927,-1.854 0.828,-4.056 -0.261,-5.82c-1.09,-1.764 -3.015,-2.837 -5.088,-2.838l-8.113,-0.002c-5.014,-0.001 -9.685,-2.542 -12.411,-6.75c-2.726,-4.208 -3.135,-9.51 -1.087,-14.086c10.162,-22.661 28.516,-40.862 51.283,-50.825l0,5.073Z" style="fill:#ff50ff;"/><g><path d="M86.215,58.274c-0.877,0 -1.83,0 -2.681,0.722c-1.031,0.902 -1.031,2.04 -1.031,3.282l0,13.192l1.908,0l0,-6.084l1.418,0c2.037,0 3.944,0 5.517,-1.418c1.263,-1.137 1.727,-2.766 1.727,-4.138c0,-1.371 -0.464,-3.001 -1.727,-4.138c-1.573,-1.418 -3.351,-1.418 -5.13,-1.418Zm0,1.805c1.65,0 2.784,0 3.79,0.906c0.696,0.621 1.16,1.604 1.16,2.845c0,1.242 -0.464,2.225 -1.16,2.846c-1.005,0.905 -2.269,0.905 -4.176,0.905l-1.418,0l0,-5.303c0,-1.061 0,-1.63 0.438,-1.966c0.309,-0.233 0.67,-0.233 1.366,-0.233Z" fill="currentColor" style="fill-rule:nonzero;"/><path d="M98.693,62.992c-1.186,0 -2.681,0.361 -3.686,1.547c-1.031,1.212 -1.031,2.423 -1.031,4.511l0,6.419l1.805,0l0,-6.419c0,-1.624 0,-2.707 0.619,-3.429c0.49,-0.593 1.366,-0.928 2.294,-0.928c0.438,0 0.851,0.077 1.212,0.206l0.541,-1.624c-0.516,-0.18 -1.109,-0.284 -1.753,-0.284Z" fill="currentColor" style="fill-rule:nonzero;"/><path d="M105.267,6