@implements IDisposable

@inject IServiceProvider Services

@* Dims and blurs the page behind (Suede's reconnect overlay) and shows a centered card: the product logo inside a spinning
   ring (or the ring alone without a logo), the title, the detail, ChildContent and the service-state tree. The icon and
   product name default to the app's registration (AddGspHouseStyle) when there is one. *@
<MudOverlay Visible="@IsVisible" DarkBackground="true" ZIndex="2000" Class="gsp-connection-overlay">
    <div class="gsp-connection-card" role="alertdialog" aria-modal="true" aria-labelledby="gsp-connection-title">
        <div class="gsp-ring indeterminate @(string.IsNullOrEmpty(EffectiveIconUrl) ? "small" : "")" role="status" aria-label="Reconnecting">
            @if (!string.IsNullOrEmpty(EffectiveIconUrl))
            {
                <img class="gsp-ring-logo" src="@EffectiveIconUrl" alt="" />
            }
        </div>
        <h2 id="gsp-connection-title" class="gsp-connection-title">@EffectiveTitle</h2>
        @if (!string.IsNullOrEmpty(Detail))
        {
            <p class="gsp-connection-detail">@Detail</p>
        }
        @ChildContent
        <div class="gsp-connection-state">
            <ServiceStateUi DataContext="DataContext" />
        </div>
    </div>
</MudOverlay>

@code {
    /// <summary>
    /// The service's health tree, rendered inside the overlay so the operator sees what is
    /// wrong before any functional test ("status before function"). By default the overlay is
    /// visible whenever this tree's aggregate state is Disconnected.
    /// </summary>
    [Parameter, EditorRequired]
    public ServiceState? DataContext { get; set; }

    /// <summary>
    /// The heading. Left unset, it reads "Reconnecting to {ProductName}..." when a product name is known (the
    /// <see cref="ProductName"/> parameter, else the app's <c>AddGspHouseStyle</c> registration) and "Disconnected from service" otherwise.
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>The product icon shown inside the ring. Defaults to the app icon of <c>AddGspHouseStyle</c>, when registered; without any the ring is shown alone.</summary>
    [Parameter]
    public string? IconUrl { get; set; }

    /// <summary>The product name for the default title. Defaults to the name derived by <c>AddGspHouseStyle</c>, when registered.</summary>
    [Parameter]
    public string? ProductName { get; set; }

    private GspAppInfo? AppInfo => Services.GetService(typeof(GspAppInfo)) as GspAppInfo;

    private string? EffectiveIconUrl => IconUrl ?? AppInfo?.IconUrl;

    private string EffectiveTitle
    {
        get
        {
            if (Title is not null)
            {
                return Title;
            }
            string? name = ProductName ?? AppInfo?.ProductName;
            return string.IsNullOrEmpty(name) ? "Disconnected from service" : $"Reconnecting to {name}...";
        }
    }

    /// <summary>Free-text status line, e.g. a retry-attempt counter.</summary>
    [Parameter]
    public string? Detail { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Overrides the visibility derivation for hosts that track connectedness separately.</summary>
    [Parameter]
    public bool? VisibleOverride { get; set; }

    private bool IsVisible => VisibleOverride ?? DataContext?.AggregateState == RemoteServiceStates.Disconnected;

    private ServiceState? _subscribed;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, DataContext))
        {
            return;
        }
        Unsubscribe();
        if (DataContext is not null)
        {
            DataContext.PropertyChanged += OnStateChanged;
            DataContext.AllUpdated += OnAllUpdated;
            _subscribed = DataContext;
        }
    }

    private void OnStateChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
        => _ = InvokeAsync(StateHasChanged);

    private void OnAllUpdated(object? sender, EventArgs e)
        => _ = InvokeAsync(StateHasChanged);

    private void Unsubscribe()
    {
        if (_subscribed is not null)
        {
            _subscribed.PropertyChanged -= OnStateChanged;
            _subscribed.AllUpdated -= OnAllUpdated;
            _subscribed = null;
        }
    }

    public void Dispose() => Unsubscribe();
}
