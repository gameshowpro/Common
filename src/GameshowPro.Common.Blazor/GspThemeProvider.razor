@* The accent and shadow variables for the active theme, written from the same GspAccent the MudBlazor palette was built from.
   Every value is a validated #rrggbb (GspAccentColors), so the markup is safe. *@
<style>@((MarkupString)AccentCss)</style>
<MudThemeProvider @ref="_provider" Theme="_theme" IsDarkMode="_isDark" ObserveSystemDarkModeChange="false" />

@code {
    private MudThemeProvider? _provider;
    private MudTheme _theme = GspHouseTheme.Create(GspAccent.Indigo);
    private GspAccent _themeAccent = GspAccent.Indigo;
    private bool _isDark;

    /// <summary>The product's accent. Defaults to <see cref="GspAccent.Indigo"/>. Changing it rebuilds the theme.</summary>
    [Parameter]
    public GspAccent Accent { get; set; } = GspAccent.Indigo;

    /// <summary>
    /// Forces the theme (<c>true</c> dark, <c>false</c> light). Left <c>null</c> (the default), the theme follows the
    /// operating system's light/dark setting at startup and live, as the house style requires.
    /// </summary>
    [Parameter]
    public bool? ForceDarkMode { get; set; }

    /// <summary>Raised with the effective mode (<c>true</c> = dark) once the system setting is known and whenever it changes.</summary>
    [Parameter]
    public EventCallback<bool> IsDarkModeChanged { get; set; }

    /// <summary>The theme in effect, for consumers that want to read palette values.</summary>
    public MudTheme Theme => _theme;

    private GspAccentColors CurrentAccent => _isDark ? Accent.Dark : Accent.Light;

    private string AccentCss => $":root{{--gsp-accent:{CurrentAccent.Fill};--gsp-accent-ink:{CurrentAccent.OnFill};--gsp-shadow:{(_isDark ? "none" : "0 1px 3px rgba(0,0,0,.07)")};color-scheme:{(_isDark ? "dark" : "light")};}}";

    protected override void OnParametersSet()
    {
        ArgumentNullException.ThrowIfNull(Accent);
        if (!ReferenceEquals(Accent, _themeAccent))
        {
            _themeAccent = Accent;
            _theme = GspHouseTheme.Create(Accent);
        }
        if (ForceDarkMode is bool forced)
        {
            _isDark = forced;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _provider is not null && ForceDarkMode is null)
        {
            // MudBlazor's own observer is off so that this component alone decides the mode (a forced mode must not
            // be overridden by an OS change).
            _isDark = await _provider.GetSystemDarkModeAsync();
            await _provider.WatchSystemDarkModeAsync(OnSystemModeChanged);
            StateHasChanged();
            await IsDarkModeChanged.InvokeAsync(_isDark);
        }
    }

    private async Task OnSystemModeChanged(bool isDark)
    {
        if (ForceDarkMode is not null)
        {
            return;
        }
        _isDark = isDark;
        await InvokeAsync(StateHasChanged);
        await IsDarkModeChanged.InvokeAsync(isDark);
    }
}
