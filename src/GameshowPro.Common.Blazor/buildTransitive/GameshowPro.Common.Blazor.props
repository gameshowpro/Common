<Project>
  <!--
    Adds the facts the GameshowPro house style shows in a product's About dialog to the consuming app's assembly as
    AssemblyMetadata, so that the app declares nothing twice: the build date, the license expression, the project URL and a
    documentation URL, when the project defines them. The product name, version, copyright and repository URL come from the
    SDK's own assembly attributes (Product, InformationalVersion, Copyright, RepositoryUrl).

    Imported automatically when the package is referenced. A project that references GameshowPro.Common.Blazor as a PROJECT
    imports it explicitly:
      <Import Project="path\to\Common\src\GameshowPro.Common.Blazor\build\GameshowPro.Common.Blazor.props" />

    Set GspBuildInstantUtc (an ISO 8601 UTC instant) to make a build reproducible. GspBuildDate remains compatible with
    date-only overrides; an explicit date-only value does not invent a build time. Either may be set in the project file or
    as a global property (-p:), because the defaults are computed when the target runs, after the project file has been read
    (a .props file is imported before the project's own body). GspAddAssemblyMetadata=false turns the whole thing off.
  -->
  <PropertyGroup>
    <GspAddAssemblyMetadata Condition="'$(GspAddAssemblyMetadata)' == ''">true</GspAddAssemblyMetadata>
  </PropertyGroup>
  <Target Name="GspAddAssemblyMetadata" BeforeTargets="GetAssemblyAttributes" Condition="'$(GspAddAssemblyMetadata)' == 'true'">
    <PropertyGroup>
      <GspBuildInstantUtc Condition="'$(GspBuildInstantUtc)' == '' and '$(GspBuildDate)' == ''">$([System.DateTime]::UtcNow.ToString('O'))</GspBuildInstantUtc>
      <GspBuildDate Condition="'$(GspBuildDate)' == '' and '$(GspBuildInstantUtc)' != ''">$([System.String]::Copy('$(GspBuildInstantUtc)').Substring(0,10))</GspBuildDate>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="GspBuildDate" Value="$(GspBuildDate)" />
      <AssemblyMetadata Include="GspBuildInstantUtc" Value="$(GspBuildInstantUtc)" Condition="'$(GspBuildInstantUtc)' != ''" />
      <AssemblyMetadata Include="PackageLicenseExpression" Value="$(PackageLicenseExpression)" Condition="'$(PackageLicenseExpression)' != ''" />
      <AssemblyMetadata Include="PackageProjectUrl" Value="$(PackageProjectUrl)" Condition="'$(PackageProjectUrl)' != ''" />
      <AssemblyMetadata Include="GspDocumentationUrl" Value="$(GspDocumentationUrl)" Condition="'$(GspDocumentationUrl)' != ''" />
    </ItemGroup>
  </Target>
</Project>
