<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>15.0</LangVersion>
    <Configurations>Debug;Release;ReleaseWindows;DebugWindows</Configurations>
    <!-- This assembly stands in for an app in HouseStyleRegistrationTests: the properties below are what GspAppInfo derives from. -->
    <RepositoryUrl>https://github.com/gameshowpro/Example</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GspDocumentationUrl>https://example.test/docs</GspDocumentationUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="bunit" Version="2.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameshowPro.Common.Blazor\GameshowPro.Common.Blazor.csproj" />
  </ItemGroup>
  <!-- A project that references GameshowPro.Common.Blazor as a PROJECT imports its props file explicitly (a package reference does it by itself). -->
  <Import Project="..\GameshowPro.Common.Blazor\build\GameshowPro.Common.Blazor.props" />
</Project>
