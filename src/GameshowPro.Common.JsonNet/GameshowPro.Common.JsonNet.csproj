<Project Sdk="Microsoft.NET.Sdk">
  <Choose>
    <When Condition="'$(Configuration)' == 'ReleaseWindows' OR '$(Configuration)' == 'DebugWindows'">
      <PropertyGroup>
        <TargetFrameworks>net10.0-windows</TargetFrameworks>
        <DefineConstants>$(DefineConstants);WPF</DefineConstants>
        <Title>GameshowPro utilities for Json.NET - Windows version</Title>
        <PackageTags>GameshowPro Common Json.NET Windows</PackageTags>
        <UseWpf>true</UseWpf>
        <UseWindowsForms>true</UseWindowsForms>
        <PackageId>GameshowPro.Common.JsonNet.Windows</PackageId>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <Title>GameshowPro utilities for Json.NET - cross-platform</Title>
        <PackageTags>GameshowPro Common  Json.NET </PackageTags>
        <PackageId>GameshowPro.Common.JsonNet</PackageId>
    </PropertyGroup>
    </Otherwise>
  </Choose>
  <PropertyGroup>
    <RootNamespace>GameshowPro.Common</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Json.NET is reflection-driven by design in this package. -->
    <NoWarn>$(NoWarn);IL2026;IL2057;IL3050</NoWarn>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>AnyCPU;x64;ARM64;ARM32</Platforms>
    <LangVersion>preview</LangVersion>
    <Company>Barjonas LLC</Company>
    <Authors>Hamish Barjonas</Authors>
    <Copyright>Barjonas LLC 2026</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <RootNamespace>GameshowPro.Common</RootNamespace>
    <Product>GameshowPro utilities for Json.NET</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;ReleaseWindows;DebugWindows</Configurations>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <OutputPath>bin\$(Configuration)</OutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.xml</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>gameshowpro-icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/gameshowpro/Common</RepositoryUrl>
    <PackageProjectUrl>https://github.com/gameshowpro/Common</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\docs\GameshowPro.Common.JsonNet\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\resources\gameshowpro-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Microsoft.Extensions.Logging is supplied transitively by the GameshowPro.Common
         ProjectReference below; do not add it directly here. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameshowPro.Common\GameshowPro.Common.csproj" />
  </ItemGroup>
</Project>
